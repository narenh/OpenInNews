{
  "manifest_version": 3,
  "name": "Open in News",
  "version": "1.0",
  "description": "Opens paywalled publisher articles in the Apple News app.",
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png",
    "256": "icons/256.png",
    "512": "icons/512.png"
  },
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": ["https://news-assets.apple.com/*"],
  "background": {
    "scripts": ["compat.js", "sites.js", "owl.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["compat.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  }
}
